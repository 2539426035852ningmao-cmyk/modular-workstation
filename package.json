{
  "name": "modular-workstation",
  "productName": "模块化工作站",
  "version": "0.1.0-prototype",
  "private": true,
  "type": "module",
  "description": "Windows desktop shell prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "package:win": "npm run build && electron-packager . ModularWorkstation --platform=win32 --arch=x64 --out=../portable --overwrite --prune=true --ignore=^/\\.git --ignore=^/tests --ignore=^/docs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
