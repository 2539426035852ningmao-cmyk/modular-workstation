{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modular Workstation Tauri Comparison",
  "version": "0.1.0",
  "identifier": "org.modularworkstation.frameworkcomparison",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Modular Workstation Framework Comparison",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 540,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
